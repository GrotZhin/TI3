      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 6776556334300307709, guid: 19f3aaf406c674942b0d3c03d02eb3b5, type: 3}
      propertyPath: rockMetalText
      value: Quartzo
      objectReference: {fileID: 0}
    - target: {fileID: 6776556334300307709, guid: 19f3aaf406c674942b0d3c03d02eb3b5, type: 3}
      propertyPath: childToActivate
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 6776556334300307709, guid: 19f3aaf406c674942b0d3c03d02eb3b5, type: 3}
      propertyPath: informativeBody
      value: "O quartzo rosa \xE9 uma variedade do quartzo, famoso pela sua colora\xE7\xE3o
        delicada. A cor surge devido a pequenas inclus\xF5es minerais ou presen\xE7a
        de tit\xE2nio, ferro e mangan\xEAs em sua estrutura. Costuma ser encontrado
        em grandes blocos, e n\xE3o em cristais bem definidos. \xC9 muito usado em
        joias e tamb\xE9m associado a significados culturais de amor e harmonia."
      objectReference: {fileID: 0}
    - target: {fileID: 6776556334300307709, guid: 19f3aaf406c674942b0d3c03d02eb3b5, type: 3}
      propertyPath: informativeHeader
      value: "F\xF3rmula: SiO\u2082\nCor: Rosa claro a rosa intenso\nBrilho: V\xEDtreo\nOrigem
        do Nome: Do grego krystallos (gelo) e da cor rosa caracter\xEDstica."
      objectReference: {fileID: 0}
    - target: {fileID: 6776556334300307709, guid: 19f3aaf406c674942b0d3c03d02eb3b5, type: 3}
      propertyPath: inspectToActivate
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 6776556334300307709, guid: 19f3aaf406c674942b0d3c03d02eb3b5, type: 3}
      propertyPath: inspectItensCanvas
      value: 
      objectReference: {fileID: 332377790}
