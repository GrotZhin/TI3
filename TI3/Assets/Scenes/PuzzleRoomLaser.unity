  rockMetalText: Ametista
  informativeHeader: "F\xF3rmula: SiO\u2082\nCor: Violeta \u2013 roxo\nBrilho: V\xEDtreo\nOrigem
    do Nome: Do grego a-methystos, \u201Cn\xE3o b\xEAbado\u201D.\n"
  informativeBody: "A ametista \xE9 um tipo de quartzo que pode ter tons que v\xE3o
    do violeta claro ao roxo intenso. "
  interactRadius: 2
  interactKey: 101
