PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 0}
    m_Modifications:
    - target: {fileID: 888351574341232092, guid: 49b25db401e287940836797e1e4b3a5e, type: 3}
      propertyPath: rockMetalText
      value: Magnetita
      objectReference: {fileID: 0}
    - target: {fileID: 888351574341232092, guid: 49b25db401e287940836797e1e4b3a5e, type: 3}
      propertyPath: childToActivate
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 888351574341232092, guid: 49b25db401e287940836797e1e4b3a5e, type: 3}
      propertyPath: informativeBody
      value: "A magnetita \xE9 um \xF3xido de ferro e um dos minerais mais magn\xE9ticos
        da natureza. \xC9 comum em rochas \xEDgneas e metam\xF3rficas e tem import\xE2ncia
        econ\xF4mica como principal min\xE9rio de ferro. Desde a Antiguidade, j\xE1
        era conhecida por sua atra\xE7\xE3o magn\xE9tica, sendo usada em b\xFAssolas."
      objectReference: {fileID: 0}
    - target: {fileID: 888351574341232092, guid: 49b25db401e287940836797e1e4b3a5e, type: 3}
      propertyPath: informativeHeader
      value: "F\xF3rmula: Fe\xB2\u207AFe\xB3\u207A\u2082O\u2084\nCor: Preto met\xE1lico
        a cinza-escuro\nBrilho: Met\xE1lico\nOrigem do Nome: Do termo grego magnetis
        lithos, \u201Cpedra magn\xE9tica\u201D."
      objectReference: {fileID: 0}
