  m_Script: {fileID: 11500000, guid: 7100436f6a568cb47bf7201749eeff2c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  rockMetalText: Quartzo
  informativeHeader: "F\xF3rmula: SiO\u2082\nCor: Rosa claro a rosa intenso\nBrilho:
    V\xEDtreo"
  informativeBody: "O quartzo rosa \xE9 uma variedade do quartzo, famoso pela sua
    colora\xE7\xE3o delicada. A cor surge devido a pequenas inclus\xF5es minerais
    ou presen\xE7a de tit\xE2nio, ferro e mangan\xEAs em sua estrutura. Costuma ser
    encontrado em grandes blocos, e n\xE3o em cristais bem definidos. \xC9 muito
    usado em joias e tamb\xE9m associado a significados culturais de amor e harmonia."
  interactRadius: 2
  interactKey: 101
  playerTag: Player
